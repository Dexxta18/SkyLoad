{
  "name": "skyload",
  "version": "0.1.0",
  "private": true,
  "description": "Download torrents straight to Google Drive and move files between cloud storage accounts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server/index.js",
    "start": "node --enable-source-maps dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "filename-reserved-regex": "^3.0.0",
    "megajs": "^1.3.10",
    "parse-torrent": "^11.0.24",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "webtorrent": "^3.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bittorrent-tracker": "^11.2.3",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
