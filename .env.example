# ── Required ────────────────────────────────────────────────────────────────
# Public URL of the app (no trailing slash). OAuth redirect URLs are built from it.
APP_URL=https://skyload.example.com
# 32 random bytes. Encrypts stored cloud credentials. Generate: openssl rand -base64 32
# Keep it safe: changing it disconnects every account.
ENCRYPTION_KEY=

# Google sign-in + Google Drive (https://console.cloud.google.com/apis/credentials)
# Redirect URI: ${APP_URL}/api/auth/callback/gdrive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "full" = browse all of Drive (restricted scope; needs Google's security review for a public app)
# "file" = only files Skyload creates (non-sensitive; torrent downloads still work)
GOOGLE_DRIVE_SCOPE=full

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. If unset, an embedded database in DATA_DIR is used
# (single process only; fine for trying it out).
DATABASE_URL=
DATA_DIR=./data

# ── Optional providers ─────────────────────────────────────────────────────
# Dropbox (https://www.dropbox.com/developers/apps). Redirect: ${APP_URL}/api/auth/callback/dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# OneDrive (Azure app registration). Redirect: ${APP_URL}/api/auth/callback/onedrive
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Mega needs no app registration.
MEGA_ENABLED=true

# ── Process layout ─────────────────────────────────────────────────────────
# all = web + worker in one process; web / worker to split them (needs DATABASE_URL)
ROLE=all
PORT=3000

# ── Limits ─────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
MAX_ACTIVE_JOBS_PER_USER=2
MAX_QUEUED_JOBS_PER_USER=20
MAX_TORRENT_SIZE_GB=50
MIN_FREE_DISK_GB=2
METADATA_TIMEOUT_MINUTES=10
STALL_TIMEOUT_MINUTES=30

# ── BitTorrent ─────────────────────────────────────────────────────────────
# Port for incoming peers (open it in your firewall for better speeds). 0 = random.
TORRENT_PORT=6881
TORRENT_DHT=true
# 0 = unlimited
TORRENT_DOWNLOAD_LIMIT_KBPS=0
TORRENT_UPLOAD_LIMIT_KBPS=0

# ── Local development only ─────────────────────────────────────────────────
# Sign in with any email (ignored when NODE_ENV=production)
# DEV_LOGIN=true
# A pretend "cloud" stored in a local folder, handy for testing without Google
# LOCAL_PROVIDER_DIR=./data/cloud
